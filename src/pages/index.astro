---
import SitePage from "@/layouts/SitePage.astro";
import Navbar from "@/components/Navbar.astro";
import ProgressBar from "@/components/ProgressBar";
import AmbientBackground from "@/components/AmbientBackground";
import ScrollRail from "@/components/ScrollRail";
import { Toaster } from "@/components/starwind/toast";
import Countries from "@/data/countries.json";
import { homeEn } from "@/i18n/home";

import Hero from "@/components/home/Hero.astro";
import HowItWorks from "@/components/home/HowItWorks.astro";
import TeamSection from "@/components/home/TeamSection.astro";
import Receipts from "@/components/home/Receipts.astro";
import TeamMap from "@/components/home/TeamMap.astro";
import Contact from "@/components/home/Contact.astro";
import SiteFooter from "@/components/home/SiteFooter.astro";
import AnchorScroll from "@/components/home/AnchorScroll.astro";

const copy = homeEn;
const totalDevs = Countries.reduce((sum, d) => sum + d.count, 0);

const stripNumber = (label: string) => label.replace(/^\d+ · /, "");
const railSections = [
    { id: "#top", label: "Intro" },
    { id: "#how", label: stripNumber(copy.how.label) },
    { id: "#team", label: stripNumber(copy.team.label) },
    { id: "#receipts", label: stripNumber(copy.receipts.label) },
    { id: "#team-map", label: stripNumber(copy.teamMap.badge) },
    { id: "#contact", label: stripNumber(copy.contact.label) },
];
---

<SitePage
    title="You pick the devs. You set the price. We ship."
    description="Freelance software developers across Latam and Europe. No agencies, no middlemen. You pick the humans who build it, you set the budget, and we ship, or you don't pay."
>
    <ProgressBar client:load />
    <Navbar />
    <Toaster position="bottom-right" />

    <AmbientBackground client:load />
    <div class="relative z-10">
        <Hero
            copy={copy.hero}
            totalDevs={totalDevs}
            countries={Countries.length}
        />
        <HowItWorks copy={copy.how} />
        <TeamSection copy={copy.team} />
        <Receipts copy={copy.receipts} />
        <TeamMap
            copy={copy.teamMap}
            countries={Countries.length}
            totalDevs={totalDevs}
        />
        <Contact copy={copy.contact} />
        <SiteFooter copy={copy.footer} />
        <AnchorScroll />
    </div>
    <ScrollRail client:load sections={railSections} />
</SitePage>

<script>
    import "@/scripts/scroll-experience";
</script>
