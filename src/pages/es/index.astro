---
import SitePage from "@layouts/SitePage.astro";
import Navbar from "@components/Navbar.astro";
import ProgressBar from "@components/ProgressBar";
import Parallax from "@components/Parallax";
import Reveal from "@components/Reveal";
import Highlight from "@components/Highlight";
import GlobeSpinner from "@components/GlobeSpinner";
import {
    Carousel,
    CarouselContent,
    CarouselItem,
} from "@components/starwind/carousel";
import { Toaster } from "@components/starwind/toast";
import Countries from "@data/countries.json";
import Technologies from "@data/technologies.json";
import Socials from "@data/socials.json";
import { developers } from "@lib/developers";
import SectionLabel from "@components/SectionLabel.astro";
import ArrowRight from "@components/ArrowRight.astro";

const devicon = (slug: string) =>
    `https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/${slug}.svg`;

const simpleicon = (slug: string) =>
    `https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/${slug}.svg`;

const totalDevs = Countries.reduce((sum, d) => sum + d.count, 0);

const leadOf = (country: string) =>
    developers.find((d) => d.country === country) ?? null;

const isExternal = (url: string) => /^https?:\/\//.test(url);

const steps = [
    {
        title: "Cuéntanos tu proyecto",
        desc: "¿Qué estás construyendo, cuándo se entrega, cuál es el presupuesto? Con dos párrafos basta, hablamos en humano.",
    },
    {
        title: "Conoce a tus desarrolladores",
        desc: "Te emparejamos con las personas adecuadas. Nombres reales, perfiles reales, contactos reales. Tú eliges quién se une.",
    },
    {
        title: "Tú fijas el precio",
        desc: "Alcance fijo, tu presupuesto, sin sorpresas. Paga con PayPal, Wise, ACH, Takenos o Uglycash.",
    },
    {
        title: "We ship. Tú te quedas con el upside.",
        desc: "Demos semanales, propiedad total del código, desplegado y en vivo. El producto, el código y el beneficio son tuyos.",
    },
];

const teams = [
    {
        name: "Solo",
        tag: "Un desarrollador senior",
        desc: "MVPs, landing pages, victorias rápidas. Un dev sharp, todo tuyo.",
        price: "$30-$70",
        badge: null,
    },
    {
        name: "Dúo",
        tag: "Frontend más backend",
        desc: "Dos desarrolladores, un sprint, el doble de impulso. Hecho para plazos ajustados.",
        price: "$70-$140",
        badge: "El más elegido",
    },
    {
        name: "Trío",
        tag: "Producto completo en 4-8 semanas",
        desc: "Diseño, frontend y backend. Todo el stack según tu calendario.",
        price: "$140-$300",
        badge: "Mejor relación calidad-precio",
    },
    {
        name: "Ejército",
        tag: "Cuatro o más desarrolladores",
        desc: "¿Un lanzamiento grande con una fecha límite fija? Dinos la fecha y armamos el equipo.",
        price: "from $300",
        badge: null,
    },
];

const payments = [
    {
        name: "PayPal",
        icon: "paypal",
        glyph: null,
        note: "Global, al instante, todo el mundo lo conoce.",
    },
    {
        name: "Wise",
        icon: "wise",
        glyph: null,
        note: "Comisión por cambio de divisas que no te roba.",
    },
    {
        name: "ACH",
        icon: null,
        glyph: "ACH",
        note: "Transferencia bancaria local (país del desarrollador), simple.",
    },
    {
        name: "Takenos",
        icon: null,
        glyph: "T",
        note: "Hecho en Latam, sin fronteras, puente directo.",
    },
    {
        name: "Uglycash",
        icon: null,
        glyph: "U",
        note: "Energía de cash-app, vías cripto.",
    },
];

const quotes = [
    {
        text: "Dou construyó nuestra aplicación de presupuestos en 2 meses, hasta el día de hoy sigue cumpliendo mis mejoras. Un B2B completo por el precio de regalo.",
        who: "Oscar Feliu",
        role: "Fundador",
        org: "EvokaReformas",
        url: "https://evokareformas.com",
        avatar: "https://ui-avatars.com/api/?name=Oscar+Felidu&background=18181b&color=fff&size=96",
    },
];
---

<SitePage
    title="Software que se entrega. Precio fijado por ti."
    description="Desarrolladores de software freelance en Latam y Europa. Tú eliges a los desarrolladores, tú fijas el precio, nosotros entregamos."
>
    <ProgressBar client:load />
    <Navbar />
    <Toaster position="bottom-right" />

    <section
        id="top"
        class="relative flex min-h-svh flex-col overflow-hidden pt-16"
    >
        <div
            class="hero-stack mx-auto grid w-full max-w-7xl flex-1 items-center gap-16 px-5 py-16 sm:px-8 lg:grid-cols-2 lg:gap-12"
        >
            <Parallax client:visible speed={0.15}>
                <p
                    class="mb-6 font-mono text-xs uppercase tracking-[0.3em] text-zinc-500"
                >
                    Dou · software freelance · est. 2021
                </p>
                <h1
                    class="font-display text-[clamp(3.4rem,9vw,5.5rem)] leading-none tracking-tight text-zinc-900"
                >
                    Elige a los devs.
                    <br />
                    Elige el <Highlight client:visible>precio</Highlight>.
                    <br />
                    We ship.
                </h1>
                <p
                    class="mt-7 max-w-xl text-md font-medium leading-snug text-zinc-800 sm:text-sm"
                >
                    Dou es un equipo de 8 desarrolladores freelance en Latam y
                    Europa. Sin agencias, sin intermediarios, sin facturas
                    infladas. Tú eliges quién construye tu proyecto, tú fijas el
                    presupuesto y hablas directamente con los desarrolladores
                    que hacen el trabajo.
                </p>
                <div class="mt-9 flex flex-wrap items-center gap-4">
                    <a
                        href="#contact"
                        class="inline-flex items-center gap-2 rounded-full bg-zinc-900 px-6 py-3 text-sm font-medium text-white transition hover:bg-zinc-700"
                    >
                        Consigue tu presupuesto gratis
                    </a>
                    <a
                        href="#team"
                        class="group inline-flex items-center gap-2 rounded-full border border-zinc-300 px-6 py-3 text-sm font-medium text-zinc-700 transition hover:border-zinc-900 hover:text-zinc-900"
                    >
                        Conoce a los desarrolladores
                        <ArrowRight />
                    </a>
                </div>
                <p
                    class="mt-9 flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-xs text-zinc-500"
                >
                    <span>8 desarrolladores disponibles</span>
                    <span class="text-zinc-300">·</span>
                    <span>7 países</span>
                    <span class="text-zinc-300">·</span>
                    <span>+20 proyectos entregados</span>
                    <span class="text-zinc-300">·</span>
                    <span>respuesta en 24 h</span>
                </p>
            </Parallax>

            <Parallax client:visible speed={0.25}>
                <div class="relative mx-auto w-full max-w-md lg:max-w-none">
                    <div
                        aria-hidden="true"
                        class="dot-grid absolute -inset-5 rounded-[2.75rem] sm:-inset-7"
                    >
                    </div>
                    <div
                        class="relative overflow-hidden rounded-3xl border border-zinc-200 bg-white shadow-xl shadow-zinc-900/5"
                    >
                        <img
                            src="/assets/dou.png"
                            alt="Dou"
                            class="aspect-square w-full object-cover"
                            width="1080"
                            height="1080"
                        />
                    </div>
                    <div
                        class="glass absolute -bottom-5 -left-4 flex items-center gap-3 rounded-2xl px-4 py-3 sm:-left-8"
                    >
                        <div
                            class="flex h-9 w-9 items-center justify-center rounded-full bg-zinc-900"
                        >
                            <svg
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="white"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                <circle cx="12" cy="12" r="10"></circle>
                                <path
                                    d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8m4 2v-2m0-8V6"
                                ></path>
                            </svg>
                        </div>
                        <div>
                            <p class="font-mono text-[11px] text-zinc-900">
                                Tú fijas el precio
                            </p>
                            <p class="font-mono text-[10px] text-zinc-500">
                                alcance fijo · tu presupuesto
                            </p>
                        </div>
                    </div>
                </div>
            </Parallax>
        </div>

        <div
            class="relative overflow-hidden border-y border-zinc-200 bg-white py-5"
        >
            <div
                class="flex w-max animate-marquee whitespace-nowrap"
                data-marquee
                style="will-change: transform;"
            >
                {
                    [...Technologies, ...Technologies].map((t, i) => (
                        <span
                            class="flex items-center gap-2.5 px-6 text-sm font-medium text-zinc-500"
                            aria-hidden={i >= Technologies.length}
                        >
                            <img
                                src={devicon(t.icon)}
                                alt=""
                                class="h-5 w-5"
                                width="128"
                                height="128"
                                loading="lazy"
                            />
                            {t.name}
                        </span>
                    ))
                }
            </div>
        </div>
    </section>

    <section
        id="how"
        class="relative px-5 py-28 sm:px-8 sm:py-36"
        aria-labelledby="how-title"
    >
        <div class="mx-auto max-w-6xl">
            <SectionLabel> 01 · Cómo funciona </SectionLabel>
            <Reveal client:visible>
                <h2
                    id="how-title"
                    class="max-w-3xl font-display text-3xl leading-[1.15] tracking-tight text-zinc-900 sm:text-5xl"
                >
                    {steps.length} pasos, <Highlight client:visible
                        >nada</Highlight
                    > oculto.
                </h2>
            </Reveal>
            <Reveal client:visible delay={100}>
                <p class="mt-6 max-w-2xl text-lg leading-relaxed text-zinc-500">
                    Sin anticipos, sin llamadas de ventas, sin letra pequeña.
                    Este es todo el playbook.
                </p>
            </Reveal>
            <div class="mt-16 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
                {
                    steps.map((s, i) => (
                        <Reveal client:visible delay={i * 90}>
                            <div class="border-l border-zinc-200 pl-4">
                                <p class="font-mono text-xs text-zinc-400">
                                    {"0" + (i + 1)}
                                </p>
                                <h3 class="mt-3 text-lg font-semibold tracking-tight text-zinc-900">
                                    {s.title}
                                </h3>
                                <p class="mt-2 text-sm leading-relaxed text-zinc-500">
                                    {s.desc}
                                </p>
                            </div>
                        </Reveal>
                    ))
                }
            </div>

            <Reveal client:visible delay={120}>
                <div
                    class="mt-16 flex flex-col gap-6 rounded-3xl bg-zinc-900 p-8 text-white sm:flex-row sm:items-center sm:justify-between sm:p-10"
                >
                    <div class="flex items-start gap-5">
                        <span
                            class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-white/10"
                        >
                            <svg
                                width="22"
                                height="22"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                <path
                                    d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1 1 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"
                                ></path>
                                <path d="m9 12 2 2 4-4"></path>
                            </svg>
                        </span>
                        <div>
                            <h3 class="font-display text-2xl tracking-tight">
                                Confianza de Dou
                            </h3>
                            <p
                                class="mt-2 max-w-xl text-sm leading-relaxed text-zinc-300"
                            >
                                Alcance fijo, demos semanales, propiedad total
                                del código. Si no cumplimos la fecha de entrega,
                                el último proceso corre por nuestra cuenta.
                            </p>
                        </div>
                    </div>
                    <a
                        href="#contact"
                        class="inline-flex shrink-0 items-center justify-center gap-2 rounded-full bg-white px-6 py-3 text-sm font-medium text-zinc-900 transition hover:bg-zinc-200"
                    >
                        Empieza un proyecto
                    </a>
                </div>
            </Reveal>
        </div>
    </section>

    <section
        id="team"
        class="relative border-y border-zinc-200 bg-zinc-50/60 px-5 py-28 sm:px-8 sm:py-36"
        aria-labelledby="team-title"
    >
        <div class="mx-auto max-w-7xl">
            <SectionLabel> 02 · Elige tu equipo </SectionLabel>
            <div class="flex flex-wrap items-end justify-between gap-6">
                <Reveal client:visible>
                    <h2
                        id="team-title"
                        class="max-w-2xl font-display text-3xl leading-[1.15] tracking-tight text-zinc-900 sm:text-5xl"
                    >
                        Tu proyecto. Tus reglas. <Highlight client:visible
                            >Tu precio.</Highlight
                        >
                    </h2>
                </Reveal>
                <Reveal client:visible delay={100}>
                    <p class="max-w-sm text-base leading-relaxed text-zinc-500">
                        Elige cuántos desarrolladores se suman a tu proyecto y
                        dinos el presupuesto. Las agencias cobran $150-300 la
                        hora más anticipos. Aquí decides tú.
                    </p>
                </Reveal>
            </div>
            <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
                {
                    teams.map((t, i) => (
                        <Reveal client:visible delay={i * 80}>
                            <article class="relative flex h-full flex-col rounded-3xl border border-zinc-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg hover:shadow-zinc-900/5">
                                {t.badge && (
                                    <span class="absolute -top-3 right-5 rounded-full bg-zinc-900 px-3 py-1 font-mono text-[10px] uppercase tracking-[0.15em] text-white">
                                        {t.badge}
                                    </span>
                                )}
                                <p class="font-mono text-xs uppercase tracking-[0.25em] text-zinc-400">
                                    {i + 1}{" "}
                                    {i ? "desarrolladores" : "desarrollador"}
                                </p>
                                <h3 class="mt-3 font-display text-3xl tracking-tight text-zinc-900">
                                    {t.name}
                                </h3>
                                <p class="mt-1 text-sm font-medium text-zinc-600">
                                    {t.tag}
                                </p>
                                <p class="mt-3 flex-1 text-sm leading-relaxed text-zinc-500">
                                    {t.desc}
                                </p>
                                <p class="mt-5 border-t border-zinc-100 pt-4 font-mono text-[11px] uppercase tracking-[0.2em] text-zinc-400">
                                    Típico · {t.price}
                                </p>
                                <p class="mt-1 font-mono text-[10px] uppercase tracking-[0.2em] text-zinc-400">
                                    Rate · you set it
                                </p>
                                <a
                                    href="#contact"
                                    class="group mt-4 inline-flex items-center justify-between gap-2 rounded-full bg-zinc-900 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-zinc-700"
                                >
                                    Construye con {i + 1} {i ? "devs" : "dev"}
                                    <ArrowRight />
                                </a>
                            </article>
                        </Reveal>
                    ))
                }
            </div>
            <Reveal client:visible delay={200}>
                <p class="mt-10 text-center font-mono text-xs text-zinc-500">
                    Sin tarifa horaria fija. Nos dices el presupuesto y te
                    decimos qué podemos entregar por ese dinero. That's the
                    deal.
                </p>
            </Reveal>
        </div>
    </section>

    <section
        id="pay"
        class="relative px-5 py-28 sm:px-8 sm:py-36"
        aria-labelledby="pay-title"
    >
        <div class="mx-auto max-w-6xl">
            <SectionLabel> 03 · Paga a tu manera </SectionLabel>
            <Reveal client:visible>
                <h2
                    id="pay-title"
                    class="max-w-3xl font-display text-3xl leading-[1.15] tracking-tight text-zinc-900 sm:text-5xl"
                >
                    Paga de la forma que <Highlight client:visible
                        >te convenga</Highlight
                    >.
                </h2>
            </Reveal>
            <Reveal client:visible delay={100}>
                <p class="mt-6 max-w-2xl text-lg leading-relaxed text-zinc-500">
                    PayPal, Wise, ACH, Takenos, Uglycash. Si tu dinero funciona,
                    nosotros trabajamos. Take your pick.
                </p>
            </Reveal>
            <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-5">
                {
                    payments.map((p, i) => (
                        <Reveal client:visible delay={i * 70}>
                            <div class="flex h-full flex-col items-start rounded-3xl border border-zinc-200 bg-white p-6 shadow-sm">
                                {p.icon ? (
                                    <img
                                        src={simpleicon(p.icon)}
                                        alt={p.name}
                                        class="h-8 w-8 brightness-0"
                                        width="32"
                                        height="32"
                                        loading="lazy"
                                    />
                                ) : (
                                    <span class="flex h-9 w-9 items-center justify-center rounded-full bg-zinc-900 font-mono text-xs font-medium text-white">
                                        {p.glyph}
                                    </span>
                                )}
                                <h3 class="mt-4 text-base font-semibold tracking-tight text-zinc-900">
                                    {p.name}
                                </h3>
                                <p class="mt-1.5 text-sm leading-relaxed text-zinc-500">
                                    {p.note}
                                </p>
                            </div>
                        </Reveal>
                    ))
                }
            </div>
        </div>
    </section>

    <section
        id="receipts"
        class="relative border-y border-zinc-200 bg-zinc-50/60 px-5 py-28 sm:px-8 sm:py-36"
        aria-labelledby="receipts-title"
    >
        <div class="mx-auto max-w-5xl">
            <SectionLabel> 04 · Lo que dicen los clientes </SectionLabel>
            <Reveal client:visible>
                <h2
                    id="receipts-title"
                    class="max-w-3xl font-display text-3xl leading-[1.15] tracking-tight text-zinc-900 sm:text-5xl"
                >
                    No nos creas a nosotros. <Highlight client:visible
                        >Créeles a ellos.</Highlight
                    >
                </h2>
            </Reveal>

            <Reveal client:visible delay={150}>
                <div class="mt-14">
                    <Carousel
                        id="testimonial-carousel"
                        autoInit={false}
                        opts={{ loop: true }}
                    >
                        <CarouselContent>
                            {
                                quotes.map((q) => (
                                    <CarouselItem>
                                        <figure class="glass mx-auto max-w-3xl rounded-3xl px-8 py-10 sm:px-12">
                                            <svg
                                                width="28"
                                                height="28"
                                                viewBox="0 0 24 24"
                                                fill="currentColor"
                                                class="text-zinc-300"
                                                aria-hidden="true"
                                            >
                                                <path d="M9.583 17.321C8.553 16.227 8 15 8 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311 1.804.167 3.226 1.648 3.226 3.489a3.5 3.5 0 0 1-3.5 3.5c-1.073 0-2.099-.49-2.748-1.179Zm-8 0C.553 16.227 0 15 0 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311 1.804.167 3.226 1.648 3.226 3.489a3.5 3.5 0 0 1-3.5 3.5c-1.073 0-2.099-.49-2.748-1.179Z" />
                                            </svg>
                                            <blockquote class="mt-4 font-display text-xl leading-snug tracking-tight text-zinc-900 sm:text-2xl">
                                                {q.text}
                                            </blockquote>
                                            <figcaption class="mt-6 flex items-center gap-3">
                                                <img
                                                    src={q.avatar}
                                                    alt={q.who}
                                                    class="h-11 w-11 rounded-full border border-zinc-200"
                                                    width="44"
                                                    height="44"
                                                    loading="lazy"
                                                />
                                                <span>
                                                    <span class="block font-mono text-xs uppercase tracking-[0.2em] text-zinc-500">
                                                        {q.who} · {q.role}
                                                    </span>
                                                    <a
                                                        href={q.url}
                                                        target="_blank"
                                                        rel="noreferrer"
                                                        class="mt-0.5 inline-flex items-center gap-1 font-mono text-xs font-medium text-zinc-700 underline decoration-zinc-300 underline-offset-4 transition hover:text-zinc-900 hover:decoration-zinc-900"
                                                    >
                                                        {q.org}
                                                        <svg
                                                            width="12"
                                                            height="12"
                                                            viewBox="0 0 24 24"
                                                            fill="none"
                                                            stroke="currentColor"
                                                            stroke-width="2"
                                                            stroke-linecap="round"
                                                            stroke-linejoin="round"
                                                            aria-hidden="true"
                                                        >
                                                            <path d="M7 17 17 7m0 0H7m10 0v10" />
                                                        </svg>
                                                    </a>
                                                </span>
                                            </figcaption>
                                        </figure>
                                    </CarouselItem>
                                ))
                            }
                        </CarouselContent>
                    </Carousel>
                    {
                        quotes.length > 1 && (
                            <div class="mt-8 flex items-center justify-center gap-3">
                                <button
                                    type="button"
                                    data-carousel-prev
                                    aria-label="Cita anterior"
                                    class="flex h-10 w-10 items-center justify-center rounded-full border border-zinc-300 text-zinc-600 transition hover:border-zinc-900 hover:text-zinc-900"
                                >
                                    <svg
                                        width="16"
                                        height="16"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        aria-hidden="true"
                                    >
                                        <path d="m15 18-6-6 6-6" />
                                    </svg>
                                </button>
                                <button
                                    type="button"
                                    data-carousel-next
                                    aria-label="Cita siguiente"
                                    class="flex h-10 w-10 items-center justify-center rounded-full border border-zinc-300 text-zinc-600 transition hover:border-zinc-900 hover:text-zinc-900"
                                >
                                    <svg
                                        width="16"
                                        height="16"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        aria-hidden="true"
                                    >
                                        <path d="m9 18 6-6-6-6" />
                                    </svg>
                                </button>
                            </div>
                        )
                    }
                    <p
                        class="mt-10 text-center font-mono text-xs text-zinc-500"
                    >
                        La cifra de 20+ incluye código abierto, todo público en
                        GitHub
                    </p>
                </div>
            </Reveal>
        </div>
    </section>

    <section
        id="team-map"
        class="relative"
