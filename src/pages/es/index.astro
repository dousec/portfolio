<script>
    document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const anchor = target.closest('a[href^="#"]');
        if (!anchor) return;
        const id = anchor.getAttribute("href")?.slice(1);
        if (!id) return;
        const el = document.getElementById(id);
        if (!el) return;
        event.preventDefault();
        // @ts-ignore
        const lenis = window.lenis;
        if (lenis) {
            lenis.scrollTo(el, { offset: -64, duration: 1.4 });
        } else {
            el.scrollIntoView({ behavior: "smooth" });
        }
    });
</script>

<script>
    import "@scripts/scroll-experience";
</script>

<script>
    import { initCarousel } from "@components/starwind/carousel";
    import { toast } from "@components/starwind/toast";

    const carouselRoot = document.querySelector<HTMLElement>(
        "#testimonial-carousel",
    );
    const manager = carouselRoot
        ? initCarousel(carouselRoot, { opts: { loop: true } })
        : null;

    document
        .querySelector("[data-carousel-prev]")
        ?.addEventListener("click", () => manager?.scrollPrev());
    document
        .querySelector("[data-carousel-next]")
        ?.addEventListener("click", () => manager?.scrollNext());

    const slideCount = document.querySelectorAll(
        "#testimonial-carousel [data-slot='carousel-item']",
    ).length;

    let autoplay: number | undefined;
    if (manager && slideCount > 1) {
        autoplay = window.setInterval(() => manager.scrollNext(), 6000);
        carouselRoot?.addEventListener("pointerdown", () => {
            window.clearInterval(autoplay);
        });
    }

    document
        .querySelector("[data-copy-email]")
        ?.addEventListener("click", async () => {
            try {
                await navigator.clipboard.writeText("contact@dousec.org");
                toast.success("¡Correo copiado a tu portapapeles!");
            } catch {
                toast.info(
                    "¡Ups! No pudimos copiar el correo. Aquí está: contact@dousec.org",
                );
            }
        });
</script>
