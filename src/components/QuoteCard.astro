---
import type { Quote } from "@/i18n/home";

interface Props {
    quote: Quote;
    class?: string;
}

const { quote, class: className = "" } = Astro.props;
---

<div
    data-quote-card
    class:list={[
        "glass relative mx-auto max-w-lg rounded-3xl p-4 shadow-2xl shadow-zinc-900/10 sm:p-7",
        className,
    ]}
>
    <figure>
        <svg
            width="26"
            height="26"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="size-5 text-zinc-300 sm:size-6.5"
            aria-hidden="true"
        >
            <path
                d="M9.583 17.321C8.553 16.227 8 15 8 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311 1.804.167 3.226 1.648 3.226 3.489a3.5 3.5 0 0 1-3.5 3.5c-1.073 0-2.099-.49-2.748-1.179Zm-8 0C.553 16.227 0 15 0 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311 1.804.167 3.226 1.648 3.226 3.489a3.5 3.5 0 0 1-3.5 3.5c-1.073 0-2.099-.49-2.748-1.179Z"
            ></path>
        </svg>
        <blockquote
            data-quote-text
            class="mt-3 font-display text-base leading-snug tracking-tight text-zinc-900 sm:mt-4 sm:text-xl"
        >
            {quote.text}
        </blockquote>
        <figcaption class="mt-4 flex items-center gap-2.5 sm:mt-5 sm:gap-3">
            <img
                data-quote-avatar
                src={quote.avatar}
                alt={quote.who}
                class="size-8 rounded-full border border-zinc-200 sm:size-10"
                width="40"
                height="40"
                loading="lazy"
            />
            <span>
                <span
                    data-quote-who
                    class="block font-mono text-xs uppercase tracking-[0.2em] text-zinc-500"
                >
                    {quote.who} · {quote.role}
                </span>
                <a
                    data-quote-url
                    href={quote.url}
                    target="_blank"
                    rel="noreferrer"
                    class="mt-0.5 inline-flex items-center gap-1 font-mono text-xs font-medium text-zinc-700 underline decoration-zinc-300 underline-offset-4 transition hover:text-zinc-900 hover:decoration-zinc-900"
                >
                    <span data-quote-org>{quote.org}</span>
                    <svg
                        width="12"
                        height="12"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path d="M7 17 17 7m0 0H7m10 0v10"></path>
                    </svg>
                </a>
            </span>
        </figcaption>
    </figure>
</div>
