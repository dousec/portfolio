---
import SectionLabel from "@/components/SectionLabel.astro";
import Reveal from "@/components/Reveal";
import Highlight from "@/components/Highlight";
import QuoteCard from "@/components/QuoteCard.astro";
import {
    Carousel,
    CarouselContent,
    CarouselItem,
} from "@/components/starwind/carousel";
import type { ReceiptsCopy } from "@/i18n/home";

interface Props {
    copy: ReceiptsCopy;
}

const { copy } = Astro.props;
---

<section
    id="receipts"
    class="relative border-y border-zinc-200 bg-zinc-50/60 px-5 py-28 sm:px-8 sm:py-36"
    aria-labelledby="receipts-title"
>
    <div class="mx-auto max-w-5xl">
        <SectionLabel>{copy.label}</SectionLabel>
        <Reveal client:visible>
            <h2
                id="receipts-title"
                class="max-w-3xl font-display text-3xl leading-[1.15] tracking-tight text-zinc-900 sm:text-5xl"
            >
                {copy.titlePre}<Highlight client:visible>{copy.titleHighlight}</Highlight>{copy.titlePost}
            </h2>
        </Reveal>

        <Reveal client:visible delay={150}>
            <div class="mt-14">
                <Carousel
                    id="testimonial-carousel"
                    autoInit={false}
                    opts={{ loop: true, align: "start" }}
                >
                    <CarouselContent>
                        {
                            copy.quotes.map((q) => (
                                <CarouselItem
                                    class={copy.quotes.length > 1
                                        ? "h-full md:basis-1/2 lg:basis-1/3"
                                        : "h-full"}
                                >
                                    <QuoteCard quote={q} />
                                </CarouselItem>
                            ))
                        }
                    </CarouselContent>
                </Carousel>
                {
                    copy.quotes.length > 1 && (
                        <div class="mt-8 flex items-center justify-center gap-3">
                            <button
                                type="button"
                                data-carousel-prev
                                aria-label={copy.prevLabel}
                                class="flex h-10 w-10 items-center justify-center rounded-full border border-zinc-300 text-zinc-600 transition hover:border-zinc-900 hover:text-zinc-900"
                            >
                                <svg
                                    width="16"
                                    height="16"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                >
                                    <path d="m15 18-6-6 6-6" />
                                </svg>
                            </button>
                            <button
                                type="button"
                                data-carousel-next
                                aria-label={copy.nextLabel}
                                class="flex h-10 w-10 items-center justify-center rounded-full border border-zinc-300 text-zinc-600 transition hover:border-zinc-900 hover:text-zinc-900"
                            >
                                <svg
                                    width="16"
                                    height="16"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                >
                                    <path d="m9 18 6-6-6-6" />
                                </svg>
                            </button>
                        </div>
                    )
                }

                <p class="mt-10 text-center font-mono text-xs text-zinc-500">
                    {copy.footnote}
                </p>
            </div>
        </Reveal>
    </div>
</section>

<script>
    import { initCarousel } from "@/components/starwind/carousel";

    const carouselRoot = document.querySelector<HTMLElement>(
        "#testimonial-carousel",
    );
    const manager = carouselRoot
        ? initCarousel(carouselRoot, { opts: { loop: true, align: "start" } })
        : null;

    document
        .querySelector("[data-carousel-prev]")
        ?.addEventListener("click", () => manager?.scrollPrev());
    document
        .querySelector("[data-carousel-next]")
        ?.addEventListener("click", () => manager?.scrollNext());

    const slideCount = document.querySelectorAll(
        "#testimonial-carousel [data-slot='carousel-item']",
    ).length;

    let autoplay: number | undefined;
    if (manager && slideCount > 1) {
        autoplay = window.setInterval(() => manager.scrollNext(), 6000);
        carouselRoot?.addEventListener("pointerdown", () => {
            window.clearInterval(autoplay);
        });
    }
</script>
