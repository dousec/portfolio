---
import SectionLabel from "@/components/SectionLabel.astro";
import Reveal from "@/components/Reveal";
import Highlight from "@/components/Highlight";
import ArrowRight from "@/components/ArrowRight.astro";
import type { TeamCopy } from "@/i18n/home";

interface Props {
    copy: TeamCopy;
}

const { copy } = Astro.props;
---

<section
    id="team"
    class="relative border-y border-zinc-200 bg-zinc-50/60 px-5 py-28 sm:px-8 sm:py-36"
    aria-labelledby="team-title"
>
    <div class="mx-auto max-w-7xl">
        <SectionLabel>{copy.label}</SectionLabel>
        <div class="flex flex-wrap items-end justify-between gap-6">
            <Reveal client:visible>
                <h2
                    id="team-title"
                    class="max-w-2xl font-display text-3xl leading-[1.15] tracking-tight text-zinc-900 sm:text-5xl"
                >
                    {copy.titlePre}<Highlight client:visible>{copy.titleHighlight}</Highlight>{copy.titlePost}
                </h2>
            </Reveal>
            <Reveal client:visible delay={100}>
                <p class="max-w-sm text-base leading-relaxed text-zinc-500">
                    {copy.description}
                </p>
            </Reveal>
        </div>
        <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
            {
                copy.teams.map((t, i) => (
                    <Reveal client:visible delay={i * 80}>
                        <article class="relative flex h-full flex-col rounded-3xl border border-zinc-200 bg-white p-6 shadow-sm transition duration-300 hover:-translate-y-1.5 hover:border-zinc-900/15 hover:shadow-xl hover:shadow-zinc-900/10">
                            {t.badge && (
                                <span class="absolute -top-3 right-5 rounded-full bg-zinc-900 px-3 py-1 font-mono text-[10px] uppercase tracking-[0.15em] text-white">
                                    {t.badge}
                                </span>
                            )}
                            <p class="font-mono text-xs uppercase tracking-[0.25em] text-zinc-400">
                                {i + 1} {i ? copy.card.devPlural : copy.card.devSingular}
                            </p>
                            <h3 class="mt-3 font-display text-3xl tracking-tight text-zinc-900">
                                {t.name}
                            </h3>
                            <p class="mt-1 text-sm font-medium text-zinc-600">
                                {t.tag}
                            </p>
                            <p class="mt-3 flex-1 text-sm leading-relaxed text-zinc-500">
                                {t.desc}
                            </p>
                            <p class="mt-5 border-t border-zinc-100 pt-4 font-mono text-[11px] uppercase tracking-[0.2em] text-zinc-400">
                                {copy.card.typicalPrefix}{t.price}
                            </p>
                            <p class="mt-1 font-mono text-[10px] uppercase tracking-[0.2em] text-zinc-400">
                                {copy.card.rate}
                            </p>
                            <a
                                href="#contact"
                                class="group mt-4 inline-flex items-center justify-between gap-2 rounded-full bg-zinc-900 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-zinc-700 active:scale-[0.97]"
                            >
                                {copy.card.buildPrefix} {i + 1} {i ? "devs" : "dev"}
                                <ArrowRight />
                            </a>
                        </article>
                    </Reveal>
                ))
            }
        </div>
        <Reveal client:visible delay={200}>
            <p class="mt-10 text-center font-mono text-xs text-zinc-500">
                {copy.footnote}
            </p>
        </Reveal>
    </div>
</section>
