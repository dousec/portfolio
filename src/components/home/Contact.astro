---
import type { ContactCopy } from "@/i18n/home";
import SectionLabel from "@/components/SectionLabel.astro";
import Reveal from "@/components/Reveal";
import Highlight from "@/components/Highlight";
import ArrowRight from "@/components/ArrowRight.astro";
import Payments from "./Payments.astro";
import Socials from "@/data/socials.json";
import { simpleicon } from "@/lib/icons";

interface Props {
    copy: ContactCopy;
}

const { copy } = Astro.props;
---

<section
    id="contact"
    class="relative px-5 py-28 sm:px-8 sm:py-36"
    aria-labelledby="contact-title"
>
    <div class="mx-auto max-w-6xl">
        <SectionLabel>{copy.label}</SectionLabel>
        <div class="grid gap-14 lg:grid-cols-[1.2fr_1fr] lg:gap-16">
            <div>
                <Reveal client:visible>
                    <h2
                        id="contact-title"
                        class="font-display text-5xl leading-[1.05] tracking-tight text-zinc-900 sm:text-6xl"
                    >
                        {copy.titlePre}<Highlight client:visible
                            >{copy.titleHighlight}</Highlight
                        >{copy.titlePost}
                    </h2>
                </Reveal>
                <Reveal client:visible delay={100}>
                    <p
                        class="mt-6 max-w-lg text-lg leading-relaxed text-zinc-500"
                    >
                        {copy.description}
                    </p>
                </Reveal>
                <Reveal client:visible delay={150}>
                    <div class="mt-9 flex flex-wrap items-center gap-4">
                        <a
                            href={copy.mailtoHref}
                            class="group inline-flex items-center gap-3 rounded-full bg-zinc-900 px-6 py-3 text-sm font-medium text-white transition hover:bg-zinc-700"
                        >
                            {copy.primaryCta}
                            <ArrowRight />
                        </a>
                        <button
                            type="button"
                            data-copy-email
                            data-copy-success={copy.copySuccess}
                            data-copy-error={copy.copyError}
                            class="inline-flex items-center gap-2 rounded-full border border-zinc-300 px-6 py-3 text-sm font-medium text-zinc-700 transition hover:border-zinc-900 hover:text-zinc-900"
                        >
                            <svg
                                width="14"
                                height="14"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                <rect
                                    width="14"
                                    height="14"
                                    x="8"
                                    y="8"
                                    rx="2"
                                    ry="2"></rect>
                                <path
                                    d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
                                ></path>
                            </svg>
                            {copy.copyCta}
                        </button>
                    </div>
                </Reveal>
            </div>

            <Reveal client:visible delay={250}>
                <div class="glass rounded-3xl p-8">
                    <p
                        class="font-mono text-xs uppercase tracking-[0.25em] text-zinc-500"
                    >
                        {copy.socialsLabel}
                    </p>
                    <ul class="mt-5 space-y-1">
                        {
                            Socials.map((s) => (
                                <li>
                                    <a
                                        href={s.href}
                                        target="_blank"
                                        rel="noreferrer"
                                        class="group flex items-center justify-between gap-4 rounded-xl px-3 py-2.5 transition hover:bg-zinc-100"
                                    >
                                        <span class="flex items-center gap-3 text-sm font-medium text-zinc-700 group-hover:text-zinc-900">
                                            <img
                                                src={simpleicon(s.icon)}
                                                alt=""
                                                class="h-4.5 w-4.5 brightness-0 opacity-[0.55] transition-opacity duration-200 group-hover:opacity-100"
                                                width="24"
                                                height="24"
                                                loading="lazy"
                                            />
                                            {s.label}
                                        </span>
                                        <span class="flex items-center gap-2 font-mono text-xs text-zinc-400">
                                            {s.handle}
                                            <svg
                                                width="12"
                                                height="12"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="2"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                class="transition group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                                                aria-hidden="true"
                                            >
                                                <path d="M7 17 17 7m0 0H7m10 0v10" />
                                            </svg>
                                        </span>
                                    </a>
                                </li>
                            ))
                        }
                    </ul>
                    <div class="mt-6 border-t border-zinc-200 pt-6">
                        <p
                            class="font-mono text-xs uppercase tracking-[0.25em] text-zinc-500"
                        >
                            {copy.sinceLabel}
                        </p>
                        <p class="mt-2 text-sm text-zinc-600">
                            {copy.sinceText}
                        </p>
                    </div>
                </div>
            </Reveal>
        </div>

        {
            copy.payments && (
                <Payments copy={{ payments: copy.payments }} />
            )
        }
    </div>
</section>

<script>
    import { toast } from "@/components/starwind/toast";

    document
        .querySelector("[data-copy-email]")
        ?.addEventListener("click", async (event) => {
            const button = event.currentTarget as HTMLElement | null;
            const success =
                button?.dataset.copySuccess ?? "Email copied to your clipboard!";
            const error =
                button?.dataset.copyError ??
                "Couldn't copy the email: contact@dousec.org";
            try {
                await navigator.clipboard.writeText("contact@dousec.org");
                toast.success(success);
            } catch {
                toast.info(error);
            }
        });
</script>
