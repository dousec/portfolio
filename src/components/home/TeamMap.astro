---
import type { TeamMapCopy } from "@/i18n/home";
import Reveal from "@/components/Reveal";
import GlobeSpinner from "@/components/GlobeSpinner";
import Countries from "@/data/countries.json";
import { developers } from "@/lib/developers";

interface Props {
    copy: TeamMapCopy;
    countries: number;
    totalDevs: number;
}

const { copy, countries, totalDevs } = Astro.props;

const leadOf = (country: string) =>
    developers.find((d) => d.country === country) ?? null;

const isExternal = (url: string) => /^https?:\/\//.test(url);
---

<section
    id="team-map"
    class="relative"
    style={`--country-count: ${countries}`}
    aria-label={copy.ariaLabel}
>
    <div
        class="relative h-[65vh] overflow-hidden md:sticky md:top-16 md:h-[calc(100vh-4rem)]"
    >
        <GlobeSpinner
            client:idle
            className="md:z-10 translate-y-[max(0px,calc(8.5rem-10.86vh))] sm:translate-y-[max(0px,calc(10rem-10.86vh))] md:translate-y-0"
        />
        <div
            class="pointer-events-none absolute inset-x-0 top-16 flex flex-wrap items-start justify-between gap-2 p-6 font-mono text-xs uppercase tracking-[0.3em] text-zinc-500 sm:top-20 sm:p-8"
        >
            <span class="glass rounded-full px-3.5 py-1.5"
                >{copy.badge}</span
            >
            <span class="glass rounded-full px-3.5 py-1.5 text-zinc-700"
                >{copy.statBadge
                    .replace("{countries}", String(countries))
                    .replace("{devs}", String(totalDevs))}</span
            >
        </div>
        <div
            class="pointer-events-none absolute inset-x-0 bottom-6 hidden justify-center font-mono text-[10px] uppercase tracking-[0.35em] text-zinc-400 sm:flex"
        >
            {copy.hint}
        </div>
    </div>

    <div class="z-10 md:z-auto">
        {
            Countries.map((d, i) => {
                const lead = leadOf(d.country);
                return (
                    <div class="pointer-events-none flex h-[18vh] items-center justify-start px-[max(1.5rem,6vw)] sm:px-[max(2rem,8vw)] md:h-[23vh] md:relative md:z-11">
                        <Reveal client:visible delay={i * 60}>
                            <article class="glass pointer-events-auto flex items-center gap-5 rounded-2xl px-6 py-4 transition hover:-translate-y-0.5 hover:shadow-lg hover:shadow-zinc-900/5">
                                <span class="font-mono text-[11px] text-zinc-400">
                                    {String(i + 1).padStart(2, "0")}
                                </span>
                                <span
                                    class="text-4xl leading-none"
                                    aria-hidden="true"
                                >
                                    {d.flag}
                                </span>
                                <div>
                                    <div class="flex flex-wrap items-center gap-3">
                                        <h3 class="font-display text-2xl tracking-tight text-zinc-900">
                                            {d.country}
                                        </h3>
                                        <span class="rounded-full bg-zinc-100 px-2.5 py-0.5 font-mono text-[11px] text-zinc-600">
                                            {d.count} dev
                                            {d.count === 1 ? "" : "s"}
                                        </span>
                                    </div>
                                    <p class="mt-0.5 font-mono text-xs text-zinc-500">
                                        {d.cities.join(" · ")}
                                    </p>
                                    {lead && (
                                        <a
                                            href={lead.contact.url}
                                            target={
                                                isExternal(lead.contact.url)
                                                    ? "_blank"
                                                    : undefined
                                            }
                                            rel={
                                                isExternal(lead.contact.url)
                                                    ? "noreferrer"
                                                    : undefined
                                            }
                                            class="mt-1.5 inline-flex items-center gap-1.5 font-mono text-xs font-medium text-zinc-700 underline decoration-zinc-300 underline-offset-4 transition hover:text-zinc-900 hover:decoration-zinc-900"
                                        >
                                            {copy.messageCta}
                                            <svg
                                                width="12"
                                                height="12"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="2"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                aria-hidden="true"
                                            >
                                                <path d="M7 17 17 7m0 0H7m10 0v10" />
                                            </svg>
                                        </a>
                                    )}
                                </div>
                            </article>
                        </Reveal>
                    </div>
                );
            })
        }
    </div>
</section>
