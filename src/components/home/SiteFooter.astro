---
import type { FooterCopy } from "@/i18n/home";
import Socials from "@/data/socials.json";

interface Props {
    copy: FooterCopy;
}

const { copy } = Astro.props;
---

<footer class="border-t border-zinc-200 bg-zinc-50/70">
    <div class="mx-auto max-w-7xl px-5 py-14 sm:px-8">
        <div class="grid gap-10 sm:grid-cols-3">
            <div>
                <a
                    href="#top"
                    class="font-display text-3xl tracking-tight text-zinc-900 transition hover:opacity-70"
                >
                    Dou
                </a>
                <p
                    class="mt-3 max-w-xs text-sm leading-relaxed text-zinc-500"
                >
                    {copy.tagline}
                </p>
            </div>
            <div>
                <p
                    class="font-mono text-xs uppercase tracking-[0.25em] text-zinc-400"
                >
                    {copy.exploreLabel}
                </p>
                <ul class="mt-4 space-y-2 text-sm">
                    {
                        copy.exploreLinks.map((l) => (
                            <li>
                                <a
                                    href={l.href}
                                    class="text-zinc-600 transition hover:text-zinc-900"
                                >
                                    {l.label}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>
            <div>
                <p
                    class="font-mono text-xs uppercase tracking-[0.25em] text-zinc-400"
                >
                    {copy.connectLabel}
                </p>
                <ul class="mt-4 space-y-2 text-sm">
                    {
                        Socials.map((s) => (
                            <li>
                                <a
                                    href={s.href}
                                    target="_blank"
                                    rel="noreferrer"
                                    class="text-zinc-600 transition hover:text-zinc-900"
                                >
                                    {s.label}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>
        <div
            class="mt-12 flex flex-col items-center justify-between gap-3 border-t border-zinc-200 pt-6 font-mono text-xs text-zinc-400 sm:flex-row"
        >
            <p>
                {copy.credit.replace(
                    "{year}",
                    String(new Date().getFullYear()),
                )}
            </p>
            <a
                href="#top"
                class="flex items-center gap-2 transition hover:text-zinc-900"
            >
                {copy.backToTop}
                <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="M12 19V5m0 0-6 6m6-6 6 6"></path>
                </svg>
            </a>
        </div>
    </div>
</footer>
