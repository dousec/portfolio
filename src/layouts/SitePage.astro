---
import "@/styles/global.css";
import { getAbsoluteLocaleUrl } from "astro:i18n";

interface Props {
    title: string;
    description?: string;
}

const { title, description } = Astro.props;

const site = Astro.site ?? new URL("https://dousec.org");
const locale = Astro.currentLocale as string;

const locales = ["en", "es", "pt"];
const defaultLocale = "en";

const localeMetadata: Record<
    string,
    { description: string; image: string; imageAlt: string; og: string }
> = {
    en: {
        description:
            "Freelance software developers in Latin America and Europe. You choose the developers, you set the price, we ship.",
        image: "/og-image.png",
        imageAlt: "Dou; software that ships. Priced by you.",
        og: "en_US",
    },
    es: {
        description:
            "Desarrolladores de software freelance en Latinoamérica y Europa. Tú eliges a los desarrolladores, tú fijas el precio, nosotros entregamos.",
        image: "/og-image-es.png",
        imageAlt: "Dou; software que se entrega. Precio fijado por ti.",
        og: "es_ES",
    },
    pt: {
        description:
            "Desenvolvedores de software freelance na América Latina e Europa. Você escolhe os desenvolvedores, define o preço e nós entregamos.",
        image: "/og-image-pt.png",
        imageAlt: "Dou; software que entrega. Preço definido por você.",
        og: "pt_BR",
    },
};

const meta = localeMetadata[locale] ?? localeMetadata[defaultLocale];
const metaDescription = description ?? meta.description;
const url = getAbsoluteLocaleUrl(locale);
const ogImage = new URL(meta.image, site).href;
const ogImageAlt = meta.imageAlt;
const alternateOgLocales = locales
    .filter((l) => l !== locale)
    .map((l) => localeMetadata[l].og);

const organization = {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${site.href}#org`,
    name: "Dou",
    url: site.href,
    logo: {
        "@type": "ImageObject",
        url: new URL("/assets/dou.png", site).href,
        width: 1080,
        height: 1080,
    },
    email: "contact@dousec.org",
    description: metaDescription,
    foundingDate: "2021",
    sameAs: ["https://github.com/dousec", "https://git.dousec.org/dou"],
};

const website = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${site.href}#website`,
    url: site.href,
    name: "Dou",
    inLanguage: locales,
    publisher: { "@id": `${site.href}#org` },
};

---

<html lang={locale}>
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
        <link rel="icon" href="/assets/favicon.ico" />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/assets/apple-touch-icon.png"
        />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <meta name="theme-color" content="#ffffff" />
        <meta name="color-scheme" content="light" />
        <meta name="author" content="Dou" />
        <meta
            name="robots"
            content="index, follow, max-image-preview:large, max-snippet:-1"
        />
        <meta name="description" content={metaDescription} />

        <title>Dou • {title}</title>

        <link rel="canonical" href={url} />
        {
            locales.map((l) => (
                <link
                    rel="alternate"
                    hreflang={l}
                    href={getAbsoluteLocaleUrl(l)}
                />
            ))
        }
        <link
            rel="alternate"
            hreflang="x-default"
            href={getAbsoluteLocaleUrl(defaultLocale)}
        />

        <meta property="og:site_name" content="Dou" />
        <meta property="og:title" content={`Dou • ${title}`} />
        <meta property="og:description" content={metaDescription} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={url} />
        <meta property="og:locale" content={meta.og} />
        {
            alternateOgLocales.map((ogLocale) => (
                <meta property="og:locale:alternate" content={ogLocale} />
            ))
        }
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:secure_url" content={ogImage} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={ogImageAlt} />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={`Dou • ${title}`} />
        <meta name="twitter:description" content={metaDescription} />
        <meta name="twitter:image" content={ogImage} />
        <meta name="twitter:image:alt" content={ogImageAlt} />

        <script
            type="application/ld+json"
            set:html={JSON.stringify(organization)}
        />
        <script type="application/ld+json" set:html={JSON.stringify(website)} />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
            rel="stylesheet"
        />
        <script>
            import "@/scripts/flag-emoji-polyfill";
        </script>
    </head>
    <body>
        <slot />
    </body>
</html>
